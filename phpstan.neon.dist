includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
  level: 6
  paths: [src, corinthian-admin-column-manager.php]
  bootstrapFiles: [vendor/autoload.php, tests/phpstan-bootstrap.php]
  scanFiles:
    - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
  treatPhpDocTypesAsCertain: false
