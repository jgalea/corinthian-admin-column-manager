{
  "name": "corinthian-admin-column-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=assets/src --output-path=assets/build editor=./editor/index.js table=./table/index.js",
    "start": "wp-scripts start --webpack-src-dir=assets/src --output-path=assets/build editor=./editor/index.js table=./table/index.js",
    "lint:js": "wp-scripts lint-js assets/src",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:test": "wp-env run tests-cli --env-cwd=wp-content/plugins/colonnade composer test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@wordpress/api-fetch": "^7.44.0",
    "@wordpress/components": "^32.6.0",
    "@wordpress/element": "^6.44.0",
    "@wordpress/env": "^10.0.0",
    "@wordpress/hooks": "^4.57.0",
    "@wordpress/i18n": "^6.17.0",
    "@wordpress/icons": "^11.0.0",
    "@wordpress/scripts": "^30.0.0",
    "typescript": "~5.9.3"
  }
}
