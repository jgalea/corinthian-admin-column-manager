<?xml version="1.0"?>
<ruleset name="Corinthian">
	<file>src</file>
	<file>corinthian-admin-column-manager.php</file>
	<arg name="extensions" value="php"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
		<exclude name="Squiz.Commenting"/>
	</rule>
	<rule ref="WordPress.WP.I18n"><properties><property name="text_domain" type="array"><element value="corinthian-admin-column-manager"/></property></properties></rule>
</ruleset>
